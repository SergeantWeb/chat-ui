{
	"name": "@sergeantweb/chat-ui",
	"version": "0.1.0",
	"description": "A ChatGPT-like chat UI for Svelte 5: streaming Markdown, code blocks with copy, retry/edit/stop, attachments. Transport-agnostic, themed with CSS variables.",
	"license": "MIT",
	"type": "module",
	"author": "SergeantWeb",
	"homepage": "https://github.com/SergeantWeb/chat-ui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SergeantWeb/chat-ui.git"
	},
	"bugs": {
		"url": "https://github.com/SergeantWeb/chat-ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"chat",
		"chatgpt",
		"ai",
		"llm",
		"streaming",
		"markdown",
		"ui"
	],
	"scripts": {
		"dev": "vite dev --port 5181",
		"build": "svelte-kit sync && svelte-package && publint --strict",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "npm run check && npm test && npm run build",
		"prepare": "svelte-kit sync || echo ''"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"dompurify": "^3.4.18",
		"highlight.js": "^11.12.0",
		"marked": "^18.2.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"jsdom": "^31.0.1",
		"publint": "^0.3.25",
		"svelte": "^5.58.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
